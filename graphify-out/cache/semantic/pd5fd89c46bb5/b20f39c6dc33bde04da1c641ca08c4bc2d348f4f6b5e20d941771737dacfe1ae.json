{"nodes": [{"id": "docs_android_cellular_audio_limitation_document", "label": "Android Cellular Audio Architecture & Limitations", "file_type": "document", "source_file": "docs/ANDROID_CELLULAR_AUDIO_LIMITATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_android_cellular_audio_limitation_capture_audio_output", "label": "CAPTURE_AUDIO_OUTPUT Permission Restriction", "file_type": "concept", "source_file": "docs/ANDROID_CELLULAR_AUDIO_LIMITATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Signature|privileged permission unavailable to third-party apps; blocks VOICE_CALL/VOICE_DOWNLINK/VOICE_UPLINK capture and has no public uplink-injection equivalent, making cellular audio inaccessible to normal Android apps."}, {"id": "docs_android_cellular_audio_limitation_sip_voip_media_pipeline", "label": "App-Owned SIP/VoIP Media Pipeline", "file_type": "concept", "source_file": "docs/ANDROID_CELLULAR_AUDIO_LIMITATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen because CAPTURE_AUDIO_OUTPUT is unobtainable by third-party apps and there is no API to inject synthetic PCM into the cellular uplink; owning SIP/RTP media gives full bidirectional audio ownership needed for local VAD/ASR/TTS and sub-150ms barge-in without special privileges."}, {"id": "docs_android_cellular_audio_limitation_privileged_carrier_media_bridge", "label": "PrivilegedCarrierMediaBridge (OEM Extension Point)", "file_type": "concept", "source_file": "docs/ANDROID_CELLULAR_AUDIO_LIMITATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optional extension interface for OEM/priv-app/rooted builds where CAPTURE_AUDIO_OUTPUT is available; defaults to unsupported in retail distribution so the app always falls back to the compliant SIP/VoIP engine."}, {"id": "docs_android_cellular_audio_limitation_product_flavors", "label": "sipAgent / pstnControl Product Flavor Separation", "file_type": "concept", "source_file": "docs/ANDROID_CELLULAR_AUDIO_LIMITATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Splits the app into two flavors to enforce privacy boundaries: sipAgent has INTERNET and full autonomous AI calling; pstnControl has no INTERNET and disables autonomous calling entirely, guaranteeing zero network exfiltration for cellular call screening."}], "edges": [{"source": "docs_android_cellular_audio_limitation_document", "target": "docs_android_cellular_audio_limitation_capture_audio_output", "relation": "describes", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ANDROID_CELLULAR_AUDIO_LIMITATION.md", "source_location": null, "weight": 1.0}, {"source": "docs_android_cellular_audio_limitation_document", "target": "docs_android_cellular_audio_limitation_sip_voip_media_pipeline", "relation": "describes", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ANDROID_CELLULAR_AUDIO_LIMITATION.md", "source_location": null, "weight": 1.0}, {"source": "docs_android_cellular_audio_limitation_document", "target": "docs_android_cellular_audio_limitation_privileged_carrier_media_bridge", "relation": "describes", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ANDROID_CELLULAR_AUDIO_LIMITATION.md", "source_location": null, "weight": 1.0}, {"source": "docs_android_cellular_audio_limitation_document", "target": "docs_android_cellular_audio_limitation_product_flavors", "relation": "describes", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ANDROID_CELLULAR_AUDIO_LIMITATION.md", "source_location": null, "weight": 1.0}, {"source": "docs_android_cellular_audio_limitation_sip_voip_media_pipeline", "targe